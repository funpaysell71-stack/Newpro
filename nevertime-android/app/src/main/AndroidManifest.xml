<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
 <queries><package android:name="com.mojang.minecraftpe"/></queries>
 <application android:label="Nevertime Client" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
