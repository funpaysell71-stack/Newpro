  <activity android:name=".bridge.BridgeActivity" android:exported="false"/>
  <activity android:name=".MainActivity" android:screenOrientation="sensorLandscape" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <service android:name=".OverlayService" android:exported="false"/>
 </application>
</manifest>
